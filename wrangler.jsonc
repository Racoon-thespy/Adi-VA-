{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voice-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"ai": { "binding": "AI" },
	"rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 },
		},
	],
	"vars": {
		"ALLOWED_ORIGIN": "https://racoon-thespy.github.io",
	},
}
